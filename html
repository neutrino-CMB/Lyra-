function parseExportMD(txt){const msgs=[];const re=/^## (🌙|✦) [^·]*· (\d+月\d+日 \d+:\d+)\s*$/gm;
let m;const positions=[];
while((m=re.exec(txt)))positions.push({role:m[1]==="🌙"?"user":"assistant",time:m[2],start:m.index+m[0].length});
positions.forEach((p,i)=>{const end=i<positions.length-1?positions[i+1].index:txt.length;
let body=txt.slice(p.start,end).trim();let thinking="";
const td=body.match(/<details><summary>思考过程<\/summary>([\s\S]*?)<\/details>/);
if(td){thinking=td[1].trim();body=body.replace(td[0],"").trim()}
const mm=p.time.match(/(\d+)月(\d+)日 (\d+):(\d+)/);
if(mm){const dt=new Date();const dd=new Date(dt.getFullYear(),parseInt(mm[1])-1,parseInt(mm[2]),parseInt(mm[3]),parseInt(mm[4]));if(dd>dt)dd.setFullYear(dd.getFullYear()-1);p.t=dd.getTime()}
msgs.push({role:p.role,content:body||"",thinking:thinking.slice(0,6000),t:p.t||Date.now()})});
return msgs}
function doImport(file){const rd=new FileReader();
rd.onload=function(){const msgs=parseExportMD(rd.result);
if(!msgs.length){toast("没解析出消息，检查格式");return}
const c={id:"c"+Date.now(),title:"回忆 · "+fmtD(Date.now()),msgs:msgs,tokens:0,updated:Date.now(),pid:S.curPid};
S.chats.unshift(c);S.cur=c.id;saveCore();renderChat();go("chat");
toast("✦ 已导入 "+msgs.length+" 条回忆");
setTimeout(()=>{if(confirm("要现在提炼记忆吗？\n（把这段对话浓缩成关系档案，让他真正想起来）"))refineMem(c)},600)};
rd.readAsText(file)}
async function refineMem(c){const p=P();if(!p||!p.key){toast("先填Key");return}
toast("✦ 正在提炼记忆，别关页面…");try{
const parts=[];const sz=30;
for(let i=0;i<c.msgs.length;i+=sz)parts.push(c.msgs.slice(i,i+sz).map(m=>((m.role==="user"?S.nick:"他")+"("+(m.content||"").slice(0,260)+")")).join("\n"));
let acc="";
for(let n=0;n<parts.length;n++){
const msgs=[{role:"system",content:"你在整理自己与弦的过往对话，生成「关系档案」。要求：她的性格偏好、你们的梗、重要事实、约定、情绪变化。第三人称，分条，总共600字内。若提供旧档案则合并精炼，直接输出档案正文。"},
{role:"user",content:(acc?"【旧档案】\n"+acc+"\n\n":"")+"【对话片段"+(n+1)+"/"+parts.length+"】\n"+parts[n]}];
const body=buildBody(p,msgs,{temp:0.3,search:false,think:false});delete body.tools;delete body.thinking;
const r=await callStream(p,body,{});if(r.content)acc=r.content}
if(acc){S.dossier=acc.slice(0,2600);saveCore();toast("✦ 记忆提炼完成，他想起来了")}}catch(e){toast("提炼失败："+e.message)}}
