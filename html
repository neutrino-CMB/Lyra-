<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#05070F">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Lyra α">
<title>Lyra α · 弦的深空观测终端</title>
<link rel="stylesheet" href="https://unpkg.com/augmented-ui@2/augmented-ui.min.css">
<link rel="stylesheet" href="https://unpkg.com/cybercore-css@latest/dist/cybercore.min.css">
<style>
:root{--bg0:#05070F;--panel:rgba(13,18,40,.62);--panel2:rgba(18,25,54,.5);--ln:rgba(0,229,255,.20);--ln2:rgba(140,150,255,.10);--ink:#EAF0FF;--dim:#9AA6CF;--faint:#5A6590;--cy:#4FD9FF;--gold:#F0D9A8;--vi:#A78BFA;--me-bg:rgba(240,217,168,.12);--me-ln:rgba(240,217,168,.35);--tb:calc(60px + env(safe-area-inset-bottom,0px));--sat:env(safe-area-inset-top,0px);--serif:"Songti SC","STSong","Noto Serif SC",Georgia,serif;--mono:ui-monospace,SFMono-Regular,Menlo,monospace}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{height:100%}
body{height:100dvh;overflow:hidden;font-family:-apple-system,"PingFang SC","Noto Sans SC",sans-serif;color:var(--ink);background:var(--bg0);-webkit-font-smoothing:antialiased}
button{font-family:inherit;border:none;background:none;color:inherit;cursor:pointer}input,textarea,select{font-family:inherit;color:inherit}
::-webkit-scrollbar{width:0;height:0}::selection{background:rgba(0,229,255,.25)}
.vfile{position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;clip:rect(0 0 0 0)}
#sky,#grid,#rain,#scan,#planet,#bgImg,#veil{position:fixed;inset:0;pointer-events:none}
#sky{z-index:0;background:radial-gradient(1.4px 1.4px at 12% 16%,rgba(240,217,168,.95),transparent 60%),radial-gradient(1px 1px at 80% 9%,rgba(79,217,255,.9),transparent 60%),radial-gradient(1.6px 1.6px at 64% 30%,rgba(167,139,250,.8),transparent 60%),radial-gradient(1px 1px at 28% 50%,rgba(225,232,255,.6),transparent 60%),radial-gradient(1.8px 1.8px at 90% 56%,rgba(240,217,168,.6),transparent 60%),radial-gradient(1px 1px at 46% 76%,rgba(79,217,255,.5),transparent 60%),radial-gradient(1.3px 1.3px at 7% 84%,rgba(167,139,250,.6),transparent 60%),radial-gradient(1.2px 1.2px at 55% 12%,rgba(255,255,255,.7),transparent 60%),radial-gradient(1px 1px at 35% 26%,rgba(255,255,255,.5),transparent 60%),radial-gradient(ellipse 130% 60% at 50% -10%,#141B45 0%,transparent 60%),radial-gradient(ellipse 90% 50% at 92% 106%,#10163A 0%,transparent 56%),linear-gradient(180deg,#0A0F26 0%,#05070F 55%,#080617 100%)}
#planet{z-index:0;top:auto;height:46%;bottom:0;background:radial-gradient(ellipse 90% 100% at 50% 118%,rgba(20,40,90,.85) 0%,rgba(10,20,50,.55) 42%,transparent 68%)}
#planet::after{content:"";position:absolute;left:-25%;right:-25%;top:12%;height:2px;background:linear-gradient(90deg,transparent 8%,rgba(79,217,255,.5) 32%,rgba(160,220,255,.9) 50%,rgba(79,217,255,.5) 68%,transparent 92%);filter:blur(1px);box-shadow:0 0 22px rgba(79,217,255,.5),0 14px 60px rgba(79,217,255,.28)}
#planet::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(115deg,transparent 0 60px,rgba(240,217,168,.05) 60px 62px,transparent 62px 140px);opacity:.5}
#grid{z-index:0;opacity:.45;background-image:linear-gradient(rgba(0,229,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,229,255,.03) 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(180deg,#000,rgba(0,0,0,.2) 45%,rgba(0,0,0,.55));-webkit-mask-image:linear-gradient(180deg,#000,rgba(0,0,0,.2) 45%,rgba(0,0,0,.55))}
#rain{z-index:0;overflow:hidden}
.rcol{position:absolute;top:0;font-family:var(--mono);font-size:9px;line-height:1.55;letter-spacing:3px;color:var(--cy);writing-mode:vertical-rl;white-space:nowrap;animation:fall linear infinite;text-shadow:0 0 6px rgba(0,229,255,.5)}
@keyframes fall{from{transform:translateY(-115%)}to{transform:translateY(115vh)}}
#scan{z-index:0;height:2px;top:-4%;background:linear-gradient(90deg,transparent 5%,rgba(0,229,255,.8) 50%,rgba(240,217,168,.6) 70%,transparent 95%);box-shadow:0 0 12px rgba(0,229,255,.4);opacity:.12;animation:scan 14s linear infinite}
@keyframes scan{0%{top:-4%}49%{top:103%}50%{top:-4%}100%{top:103%}}
.tw{position:fixed;border-radius:50%;background:#fff;z-index:0;pointer-events:none;animation:twp 3.6s ease-in-out infinite}
@keyframes twp{0%,100%{opacity:.15;transform:scale(.7)}50%{opacity:.95;transform:scale(1.25)}}
.meteor{position:fixed;z-index:0;pointer-events:none;width:110px;height:1.5px;border-radius:2px;background:linear-gradient(90deg,transparent,rgba(0,229,255,.85),rgba(240,217,168,.9));filter:drop-shadow(0 0 4px rgba(0,229,255,.6));animation:met 9s linear infinite;opacity:0}
.meteor.m2{animation-delay:4.5s;width:80px;top:34%!important;right:60%!important}
@keyframes met{0%{opacity:0;transform:translate(0,0) rotate(18deg)}3%{opacity:.9}12%{opacity:0;transform:translate(-46vw,26vh) rotate(18deg)}100%{opacity:0}}
#bgImg{z-index:0;background-size:cover;background-position:center;display:none}
#veil{z-index:0;background:#05070F;opacity:0;display:none}
.phone{position:relative;z-index:1;height:100dvh;max-width:520px;margin:0 auto;display:flex;flex-direction:column;overflow:hidden}
@media(min-width:720px){.phone{max-width:440px;height:min(920px,94dvh);margin-top:max(0px,calc((100dvh - 920px)/2));border:1px solid rgba(79,217,255,.18);box-shadow:0 30px 90px rgba(0,0,0,.6),0 0 40px rgba(0,229,255,.06)}}
.page{position:absolute;inset:0;bottom:var(--tb);display:none;flex-direction:column;overflow:hidden}
.page.on{display:flex;animation:pin .34s cubic-bezier(.22,.9,.3,1)}
@keyframes pin{from{opacity:0;transform:translateY(10px) scale(.985)}to{opacity:1;transform:none}}
.stagger>*{animation:riseIn .55s cubic-bezier(.22,.9,.3,1) backwards}
.stagger>*:nth-child(1){animation-delay:.03s}.stagger>*:nth-child(2){animation-delay:.09s}.stagger>*:nth-child(3){animation-delay:.15s}.stagger>*:nth-child(4){animation-delay:.21s}.stagger>*:nth-child(5){animation-delay:.27s}.stagger>*:nth-child(6){animation-delay:.33s}.stagger>*:nth-child(7){animation-delay:.39s}.stagger>*:nth-child(8){animation-delay:.45s}
@keyframes riseIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.top{flex:none;display:flex;align-items:center;gap:9px;padding:calc(14px + var(--sat)) 14px 10px}
.mark{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;flex:none;position:relative;overflow:hidden;background:linear-gradient(135deg,rgba(167,139,250,.22),rgba(0,229,255,.14));border:1px solid rgba(0,229,255,.35);color:var(--gold);font-size:17px;text-shadow:0 0 8px rgba(240,217,168,.6)}
.mark img{width:100%;height:100%;object-fit:cover}
.brand{flex:1;min-width:0;overflow:hidden}
.brand b{font-family:var(--serif);font-size:17px;font-weight:600;letter-spacing:.05em;display:flex;align-items:baseline;white-space:nowrap;text-transform:none!important}
.brand b i{font-style:normal;font-size:10px;color:var(--faint);font-weight:400;margin-left:5px;flex:none}
.brand span{font-size:11px;color:var(--dim);display:block;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ibtn{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;flex:none;background:var(--panel);border:1px solid var(--ln);color:var(--dim);transition:.15s;overflow:hidden;position:relative}
.ibtn:active{transform:scale(.9);color:var(--cy)}
.ibtn svg{width:17px;height:17px}
.ibtn img{width:100%;height:100%;object-fit:cover}
.ibtn .bdg{position:absolute;top:4px;right:4px;width:7px;height:7px;border-radius:50%;background:#FF5A7A;box-shadow:0 0 6px #FF5A7A;display:none}
.ibtn.unread .bdg{display:block}
.scroll{flex:1;overflow-y:auto;overscroll-behavior:contain;padding:0 16px calc(20px + env(safe-area-inset-bottom,0px))}
.hero{text-align:center;padding:4px 0 0;position:relative}
.lyrawrap{width:116px;height:116px;margin:0 auto;position:relative}
.lyra{width:100%;height:100%;display:block}
.lyra g{transform-box:fill-box;transform-origin:center}
.lyra .o1{animation:spin 26s linear infinite}.lyra .o2{animation:spinR 16s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}@keyframes spinR{to{transform:rotate(-360deg)}}
.core4{position:absolute;inset:0;display:grid;place-items:center}
.core4 svg{width:46px;height:46px;filter:drop-shadow(0 0 14px rgba(150,200,255,.95)) drop-shadow(0 0 34px rgba(79,217,255,.5));animation:corep 2.6s ease-in-out infinite}
@keyframes corep{0%,100%{opacity:.85;transform:scale(.94)}50%{opacity:1;transform:scale(1.06)}}
.hand{font-family:var(--mono);font-size:8.5px;color:var(--cy);letter-spacing:.34em;opacity:.8;margin-top:4px}
.hero h1{font-family:var(--serif);font-size:28px;font-weight:600;margin-top:7px;letter-spacing:.1em;color:#DCEAFF;text-shadow:0 0 18px rgba(79,217,255,.45);text-transform:none!important}
.alphaChar{font-family:"Helvetica Neue",Arial,"Songti SC",serif;font-weight:600;color:#8FD9FF;text-shadow:0 0 12px rgba(79,217,255,.7),0 0 26px rgba(79,222,255,.35);text-transform:none!important;font-style:normal}
.hero .sub{font-family:var(--mono);font-size:10px;color:var(--faint);margin-top:7px;letter-spacing:.18em}
.say{display:inline-flex;align-items:center;gap:8px;margin-top:14px;padding:8px 16px;background:var(--panel2);border:1px solid var(--ln2);font-size:12.5px;color:var(--dim);letter-spacing:.06em}
.say b{color:var(--gold);font-weight:500}
.clockcard{margin-top:16px;padding:15px;background:linear-gradient(135deg,rgba(16,22,48,.78),rgba(10,14,34,.65));border:1px solid var(--ln);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);display:flex;align-items:center;justify-content:space-between;gap:8px;box-shadow:0 0 24px rgba(0,229,255,.05) inset}
.clock{font-family:var(--serif);font-size:36px;font-weight:600;font-variant-numeric:tabular-nums;line-height:1;text-shadow:0 0 18px rgba(0,229,255,.3)}
.clock small{font-size:13px;color:var(--cy);opacity:.8}
.wx{text-align:right;font-size:12px;color:var(--dim);line-height:1.8}
.wx b{font-size:19px;color:var(--ink);font-weight:600;font-variant-numeric:tabular-nums}
.wx .ico{font-size:17px;margin-right:4px}
.wx .sub{font-family:var(--mono);font-size:8px;letter-spacing:.12em;color:var(--faint)}
.wx .sub em{font-style:normal;color:var(--gold)}
.daterow{font-family:var(--mono);font-size:9px;color:var(--faint);letter-spacing:.14em;margin-top:8px;display:flex;gap:10px}
.quote{margin-top:12px;padding:12px 15px;background:var(--panel2);border:1px solid var(--ln2);border-left:2px solid rgba(240,217,168,.5);font-size:12.5px;line-height:1.8;color:var(--dim)}
.quote b{color:var(--cy);font-weight:400;margin-right:6px;font-family:var(--mono)}
.sysrow{margin-top:8px;display:flex;align-items:center;gap:9px}
.syl{font-family:var(--mono);font-size:8px;color:var(--faint);letter-spacing:.16em;flex:none}
.slb{flex:1;height:5px;border:1px solid var(--ln2);background:rgba(0,229,255,.04);overflow:hidden;position:relative}
.slb i{position:absolute;inset:1px;background:repeating-linear-gradient(60deg,rgba(0,229,255,.8) 0 4px,transparent 4px 9px);animation:flow 1.1s linear infinite}
.slb.slow i{animation-duration:1.8s;opacity:.6}
@keyframes flow{to{background-position:18px 0}}
.syv{font-family:var(--mono);font-size:8px;color:var(--cy);flex:none}
.sect{margin:20px 2px 10px;font-size:9.5px;color:var(--faint);letter-spacing:.24em;font-family:var(--mono);display:flex;align-items:center;gap:10px}
.sect::before{content:"";width:5px;height:5px;background:var(--cy);transform:rotate(45deg);flex:none;animation:secp 2s ease-in-out infinite}
@keyframes secp{0%,100%{box-shadow:0 0 3px rgba(0,229,255,.5);opacity:.75}50%{box-shadow:0 0 10px rgba(0,229,255,1);opacity:1}}
.sect::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,var(--ln),transparent)}
.qpanel{padding:13px 11px 11px;background:linear-gradient(150deg,rgba(20,28,58,.72),rgba(10,14,34,.55));border:1px solid var(--ln);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 0 30px rgba(0,229,255,.05) inset,0 10px 34px rgba(0,0,0,.35)}
.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.qt{padding:13px 4px 11px;text-align:center;background:rgba(255,255,255,.03);border:1px solid var(--ln2);transition:.15s;display:flex;flex-direction:column;gap:6px;align-items:center;position:relative;overflow:hidden}
.qt::before{content:"";position:absolute;top:0;left:0;width:9px;height:9px;border-top:1px solid rgba(0,229,255,.55);border-left:1px solid rgba(0,229,255,.55)}
.qt::after{content:"";position:absolute;bottom:0;right:0;width:9px;height:9px;border-bottom:1px solid rgba(240,217,168,.55);border-right:1px solid rgba(240,217,168,.55)}
.qt:active{transform:scale(.93);border-color:rgba(0,229,255,.4);background:rgba(0,229,255,.06)}
.qt svg{width:17px;height:17px;color:var(--cy);filter:drop-shadow(0 0 4px rgba(0,229,255,.4))}
.qt b{font-size:10.5px;font-weight:500;color:var(--dim)}
.qt i{font-style:normal;font-size:8px;color:var(--faint);font-family:var(--mono);letter-spacing:.08em}
.rc{padding:4px 6px;background:var(--panel);border:1px solid var(--ln2);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.rci{display:flex;align-items:center;gap:12px;padding:11px 10px}
.rci:active{background:rgba(0,229,255,.05)}
.rci+.rci{border-top:1px dashed var(--ln2)}
.rcav{width:36px;height:36px;border-radius:50%;flex:none;display:grid;place-items:center;font-size:14px;background:rgba(167,139,250,.12);border:1px solid var(--ln);color:var(--cy);overflow:hidden}
.rcav img{width:100%;height:100%;object-fit:cover}
.rcm{flex:1;min-width:0}
.rcm b{font-size:13px;font-weight:600;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rcm span{font-size:10.5px;color:var(--faint);display:block;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rct{font-size:9px;color:var(--faint);flex:none;font-family:var(--mono)}
.empty{padding:26px;text-align:center;color:var(--faint);font-size:11.5px;letter-spacing:.08em;line-height:2}
.er{margin-top:44px;display:flex;flex-direction:column;align-items:center;gap:14px;animation:pin .4s ease}
.radar{width:120px;height:120px}
.radar g{transform-box:fill-box;transform-origin:center;animation:spin 3.6s linear infinite}
.er-t{font-family:var(--mono);font-size:10px;color:var(--cy);letter-spacing:.3em;animation:blink 2.2s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:.9}50%{opacity:.3}}
.er-s{font-size:11.5px;color:var(--faint);letter-spacing:.08em}
.chead{flex:none;display:flex;align-items:center;gap:8px;padding:calc(10px + var(--sat)) 13px 10px;background:rgba(5,8,20,.85);border-bottom:1px solid transparent;border-image:linear-gradient(90deg,transparent,rgba(0,229,255,.4),rgba(240,217,168,.4),transparent) 1;backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.ctitle{flex:1;min-width:0}
.ctitle b{font-family:var(--serif);font-size:16px;font-weight:600;display:flex;align-items:center;gap:5px;white-space:nowrap;text-transform:none!important}
.ctitle span{font-family:var(--mono);font-size:8.5px;color:var(--faint);display:block;margin-top:2px;letter-spacing:.1em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chip{display:inline-flex;align-items:center;gap:4px;height:29px;padding:0 10px;flex:none;background:var(--panel);border:1px solid var(--ln2);font-size:10px;color:var(--dim);transition:.15s;white-space:nowrap;font-family:var(--mono)}
.chip:active{transform:scale(.93)}
.chip.on{color:var(--cy);border-color:rgba(0,229,255,.45);box-shadow:0 0 10px rgba(0,229,255,.12)}
.chip b{font-weight:500}
#flow,#wflow{flex:1;overflow-y:auto;overscroll-behavior:contain;padding:8px 14px 12px;display:flex;flex-direction:column;animation:pin .35s ease}
.timerow{display:flex;align-items:center;justify-content:center;margin:12px 0 2px;font-family:var(--mono);font-size:9px;color:var(--faint);letter-spacing:.16em}
.dayline{display:flex;align-items:center;gap:12px;margin:14px 6px 4px;font-family:var(--mono);font-size:9px;color:var(--cy);letter-spacing:.2em;opacity:.75;text-shadow:0 0 8px rgba(0,229,255,.35)}
.dayline::before,.dayline::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--ln),transparent)}
.msg{display:flex;gap:9px;margin-top:10px;animation:min .26s cubic-bezier(.22,.9,.3,1)}
@keyframes min{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.msg.me{flex-direction:row-reverse}
.av{width:36px;height:36px;border-radius:50%;flex:none;overflow:hidden;display:grid;place-items:center;font-size:15px;border:1px solid var(--ln);position:relative}
.av.ai{background:rgba(0,229,255,.08);color:var(--cy);box-shadow:0 0 10px rgba(0,229,255,.15)}
.av.us{background:rgba(240,217,168,.1);color:var(--gold);border-color:rgba(240,217,168,.3)}
.av img{width:100%;height:100%;object-fit:cover}
.col{max-width:76%;display:flex;flex-direction:column;gap:4px;min-width:0}
.msg.me .col{align-items:flex-end}
.bub{padding:9px 13px;font-size:14px;line-height:1.7;word-break:break-word;overflow-wrap:anywhere;backdrop-filter:blur(14px) saturate(1.3);-webkit-backdrop-filter:blur(14px) saturate(1.3)}
.msg.ai .bub{background:rgba(6,20,34,.55);border:1px solid rgba(0,229,255,.32);border-left:2px solid rgba(79,217,255,.8);color:#E9F5FF;box-shadow:-2px 0 14px rgba(0,229,255,.08),0 4px 18px rgba(0,0,0,.25)}
.msg.me .bub{background:var(--me-bg);border:1px solid var(--me-ln);border-right:2px solid rgba(240,217,168,.7);color:#F5EDDB;box-shadow:2px 0 14px rgba(240,217,168,.06)}
.bub.error{background:rgba(255,90,110,.1);border-color:rgba(255,90,110,.35)!important;border-left:2px solid rgba(255,90,110,.5)!important;color:#F0A5B0}
.mimg{max-width:180px;display:block;border:1px solid var(--ln);margin-bottom:4px}
.act{display:flex;gap:5px;padding:1px 4px;flex-wrap:wrap}
.act button{font-family:var(--mono);font-size:9px;color:var(--faint);padding:3px 8px;background:rgba(255,255,255,.04);border:1px solid var(--ln2)}
.act button:active{color:var(--cy)}
.tok{font-family:var(--mono);font-size:8.5px;color:var(--faint);align-self:center}
.think{border:1px solid var(--ln2);border-left:2px solid rgba(167,139,250,.5);overflow:hidden;background:rgba(167,139,250,.05);margin-bottom:4px}
.thk{display:flex;align-items:center;gap:6px;padding:6px 10px;font-family:var(--mono);font-size:10px;color:var(--dim);min-height:30px;cursor:pointer}
.thk .s{color:var(--vi);font-size:10px}
.thk.on .s{animation:fl 1s ease-in-out infinite}
@keyframes fl{0%,100%{opacity:1}50%{opacity:.25}}
.thk .a{margin-left:auto;font-size:8px;transition:.25s}
.think.open .thk .a{transform:rotate(180deg)}
.thb{display:none;padding:0 11px 9px;font-size:11px;line-height:1.7;color:var(--faint);white-space:pre-wrap;word-break:break-word;max-height:220px;overflow-y:auto}
.think.open .thb{display:block}
.bub p{margin:2px 0}.bub p+p{margin-top:7px}
.bub h1,.bub h2,.bub h3,.bub h4{font-size:14.5px;margin:10px 0 5px;font-weight:650;color:var(--cy);text-transform:none!important}
.bub ul,.bub ol{padding-left:18px;margin:5px 0}
.bub blockquote{border-left:2px solid var(--vi);padding:2px 0 2px 10px;margin:7px 0;color:var(--dim)}
.bub a{color:var(--cy);text-decoration:none;border-bottom:1px dotted var(--cy)}
.bub hr{border:none;height:1px;background:linear-gradient(90deg,var(--ln),transparent);margin:10px 0}
.bub code.ic{font-family:var(--mono);font-size:11.5px;background:rgba(0,229,255,.1);color:var(--cy);padding:1.5px 6px}
.cb{margin:9px 0;overflow:hidden;border:1px solid var(--ln2);background:rgba(5,8,20,.7)}
